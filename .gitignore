# ---- Environments (never commit; rebuild via code/business_entity_resolution/src/bootstrap.sh)
.venv/
venv/
__pycache__/
*.py[cod]

# ---- Challenge data (2.4 GB, redistributed by the organisers, not ours to commit)
dataset/

# ---- Derived artefacts (regenerable; see README for the commands)
work/            # country-partitioned parquet store (~864 MB)
logs/
*.parquet
*.npy
*.memmap

# ---- Submission outputs (regenerable, and large once blocking is real)
# Kept out of git deliberately: candidate_pairs.tsv reaches ~1 GB at full
# candidate width. The submission ZIP is built from these, but the repo tracks
# the code that produces them, not the files themselves.
output/*.tsv
*.tsv

# ---- OS noise
.DS_Store

# ---- Trained artefacts
# models/reranker.pkl IS committed: 2.2 KB (16 coefficients + a scaler), and it
# makes the pipeline runnable without re-deriving the pair-feature cache.
# work/paircache/*.npz IS committed via Git LFS (460 MB): the labelled training
# pairs. Not cheaply regenerable -- ~25 min of retrieval + feature computation --
# so shipping it lets anyone retrain the reranker immediately.
work/store/              # country-partitioned parquet, regenerable in ~23s
work/*.tsv               # intermediate candidate files
prod/                    # production candidate output (regenerable; see docs/DATA.md)
models/*.bin
